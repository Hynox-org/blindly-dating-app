class SwipeableMessage extends StatefulWidget {
  final Message message;
  final Message? replyMessage;
  final bool isMe;
  final VoidCallback onReply;
  final Function(String) onReact;
  final String Function(DateTime) formatTime;

  const SwipeableMessage({
    super.key,
    required this.message,
    required this.replyMessage,
    required this.isMe,
    required this.onReply,
    required this.onReact,
    required this.formatTime,
  });

  @override
  State<SwipeableMessage> createState() =>
      _SwipeableMessageState();
}

class _SwipeableMessageState extends State<SwipeableMessage> {
  double _dragX = 0;

  @override
  Widget build(BuildContext context) {
    return GestureDetector(
      onHorizontalDragUpdate: (d) {
        if (d.delta.dx > 0) {
          setState(() => _dragX += d.delta.dx * .9);
        }
      },
      onHorizontalDragEnd: (_) {
        if (_dragX > 85) widget.onReply();
        setState(() => _dragX = 0);
      },
      onLongPress: () => _showReactionPicker(context),
      child: Transform.translate(
        offset: Offset(_dragX, 0),
        child: _bubble(),
      ),
    );
  }

  Widget _bubble() {
    final textColor =
        widget.isMe ? Colors.white : Colors.black;

    final hasReaction = widget.message.reaction != null;

    return Align(
      alignment:
          widget.isMe ? Alignment.centerRight : Alignment.centerLeft,
      child: Container(
        margin: const EdgeInsets.only(bottom: 18),
        padding: EdgeInsets.fromLTRB(
          14,
          10,
          14,
          hasReaction ? 10 : 10,
        ),
        decoration: BoxDecoration(
          color:
              widget.isMe ? const Color(0xFF3F472E) : const Color(0xFFEBC163),
          borderRadius: BorderRadius.circular(18),
        ),
        child: Stack(
          clipBehavior: Clip.none,
          children: [
            Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                if (widget.replyMessage != null)
                  _replyPreview(),

                Row(
                  mainAxisSize: MainAxisSize.min,
                  children: [
                    Flexible(
                      child: Text(
                        widget.message.text,
                        style: TextStyle(color: textColor),
                      ),
                    ),
                    const SizedBox(width: 6),
                    Text(
                      widget.formatTime(widget.message.createdAt),
                      style: TextStyle(
                        fontSize: 10,
                        color: textColor.withOpacity(.75),
                      ),
                    ),
                  ],
                ),
              ],
            ),
            if (hasReaction)
              Positioned(
                bottom: -28,
                left: widget.isMe ? null : -8,
                right: widget.isMe ? -8 : null,
                child: Container(
                  padding:
                      const EdgeInsets.symmetric(horizontal: 3, vertical: 3),
                  decoration: BoxDecoration(
                    color: Colors.white,
                    borderRadius: BorderRadius.circular(14),
                    boxShadow: const [
                      BoxShadow(
                        blurRadius: 6,
                        color: Colors.black12,
                      ),
                    ],
                  ),
                  child: Text(
                    widget.message.reaction!,
                    style: const TextStyle(fontSize: 14),
                  ),
                ),
              )
          ],
        ),
      ),
    );
  }

  Widget _replyPreview() {
    return Container(
      margin: const EdgeInsets.only(bottom: 6),
      padding:
          const EdgeInsets.symmetric(horizontal: 8, vertical: 6),
      decoration: BoxDecoration(
        color: Colors.black.withOpacity(.18),
        borderRadius: BorderRadius.circular(10),
      ),
      child: Row(
        children: [
          Container(width: 3, height: 32, color: Colors.greenAccent),
          const SizedBox(width: 6),
          Expanded(
            child: Text(
              widget.replyMessage!.text,
              maxLines: 2,
              overflow: TextOverflow.ellipsis,
              style: TextStyle(
                fontSize: 12,
                color: Colors.white.withOpacity(.85),
              ),
            ),
          )
        ],
      ),
    );
  }

  void _showReactionPicker(BuildContext context) {
    const reactions = ['❤️', '😂', '😮', '😢', '👍'];

    showModalBottomSheet(
      context: context,
      builder: (_) => Padding(
        padding: const EdgeInsets.symmetric(vertical: 16),
        child: Row(
          mainAxisAlignment: MainAxisAlignment.spaceEvenly,
          children: reactions
              .map(
                (e) => GestureDetector(
                  onTap: () {
                    Navigator.pop(context);
                    widget.onReact(e);
                  },
                  child: Text(e, style: const TextStyle(fontSize: 30)),
                ),
              )
              .toList(),
        ),
      ),
    );
  }
}

// ======================================================
// MODEL
// ======================================================

class Message {
  final String id;
  final String matchId;
  final String senderProfileId;
  final String text;
  final DateTime createdAt;
  final String? replyToId;
  String? reaction;

  Message({
    required this.id,
    required this.matchId,
    required this.senderProfileId,
    required this.text,
    required this.createdAt,
    this.replyToId,
    this.reaction,
  });

  factory Message.fromMap(Map<String, dynamic> map) {
    return Message(
      id: map['id'].toString(),
      matchId: map['match_id'],
      senderProfileId: map['sender_profile_id'],
      text: map['content'],
      createdAt: DateTime.parse(map['created_at']).toLocal(),
      replyToId: map['reply_to_id'],
      reaction: map['reaction'],
    );
  }
}
